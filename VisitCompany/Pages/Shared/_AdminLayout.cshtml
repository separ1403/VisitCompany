<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="~/Theme/assets/css/fonts.css" rel="stylesheet">
    <link href="~/Theme/assets/css/main.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css?family=Material+Icons+Outlined" rel="stylesheet" type="text/css">
    <link href="https://cdn.jsdelivr.net/npm/quasar@2.18.1/dist/quasar.rtl.prod.css" rel="stylesheet" type="text/css">
    <link href="~/Theme/assets/css/quasar/custom.css" rel="stylesheet">
    <link href="~/AdminTheme/assets/css/adminLayout.css" rel="stylesheet">
    @RenderSection("Styles", required: false)
</head>
<body>
<div id="app">
    <q-layout view="hHh Lpr fFr" style="height: 100vh">
        <q-header elevated>
            <q-toolbar>
                <div class="header__menu">
                    <div class="header__menu-right">
                        <q-btn flat dense round icon="menu" v-on:click="drawer = !drawer" class="q-mr-md">
                            <q-tooltip>منو</q-tooltip>
                        </q-btn>
                        <img src="/Theme/assets/img/etc/separ-header.png" alt="سپر" width="60">
                    </div>
                    <div class="header__menu-left">
                        <q-avatar class="header__avatar" color="deep-purple-9" text-color="white">
                            خ
                            <q-menu class="q-pa-md">
                                <div class="row no-wrap">
                                    <div class="user__info">
                                        <b>حسن خالقی</b>
                                        <span> (40458585) </span>
                                    </div>
                                </div>
                                <q-btn class="full-width" color="red-6" label="خروج"></q-btn>
                            </q-menu>
                        </q-avatar>
                    </div>
                </div>
            </q-toolbar>
        </q-header>

        <q-drawer v-model="drawer" show-if-above side="left">
            <q-list>
                <q-item v-for="(item, index) in menuItems" :key="index" clickable v-ripple :active="isActive(item.path)">
                    <q-item-section avatar>
                        <q-icon :name="item.icon"/>
                    </q-item-section>
                    <q-item-section>
                        {{ item.label }}
                    </q-item-section>
                </q-item>
            </q-list>
        </q-drawer>

        <q-page-container>
            <q-page padding>
                @RenderBody()
            </q-page>
        </q-page-container>
    </q-layout>
</div>

<script src="https://cdn.jsdelivr.net/npm/vue@3.4.21/dist/vue.global.prod.js"></script>
<script src="https://cdn.jsdelivr.net/npm/quasar@2.18.1/dist/quasar.umd.prod.js"></script>
<script src="https://cdn.jsdelivr.net/npm/quasar@2.18.0/dist/lang/fa.umd.prod.js"></script>
<script src="https://cdn.jsdelivr.net/npm/quasar@2.18.1/dist/icon-set/material-icons-outlined.umd.prod.js"></script>


<script>
    const app = Vue.createApp({
        data() {
            return {
                drawer: false,
                menuItems: [
                    { label: 'داشبورد', icon: 'dashboard', path: '/' },
                    { label: 'ناحیه کسب و کار', icon: 'business', path: '/Business' },
                    { label: 'مدیریت و ارزیابی', icon: 'edit_note', path: '/Management' },
                    { label: 'مجوزها', icon: 'workspace_premium', path: '/Permissions' },
                    { label: 'آمار و گزارش‌گیری', icon: 'insert_chart_outlined', path: '/Reports' },
                    { label: 'اطلاعات افراد', icon: 'groups', path: '/People' },
                    { label: 'مدیریت دسترسی', icon: 'lock', path: '/Access' },
                    { label: 'تنظیمات', icon: 'settings', path: '/Settings' }
                ]
            };
        },
        methods: {
            isActive(path) {
                return window.location.pathname === path;
            }
        }
    });

    // سیستم ثبت کامپوننت‌ها (مشابه _Layout.cshtml)
    window.componentRegistry = window.componentRegistry || {};
    window.registerComponent = function(name, component) {
        window.componentRegistry[name] = component;
        app.component(name, component);
    };

    // ثبت کامپوننت پیش‌فرض
    app.component('default-page', {
        template: `<div>صفحه پیش‌فرض</div>`
    });



    // اجرای بعد از لود DOM
    document.addEventListener('DOMContentLoaded', () => {
        Object.keys(window.componentRegistry).forEach(name => {
            app.component(name, window.componentRegistry[name]);
        });
        app.mount('#app');
    });

    // استفاده از Quasar
    app.use(Quasar, {
        config: {
            iconSet: 'material-icons-outlined',
            lang: 'fa',
            rtl: true,
        }
    });
    Quasar.lang.set(Quasar.lang.fa);


</script>
@RenderSection("Scripts", required: false)
</body>
</html>