<!DOCTYPE html>
<html lang="fa">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>

    @if (ViewData["Title"] != null)
    {
        <title>@ViewData["Title"]</title>
    }
    else
    {
        <title>وب سایت</title>
    }

    <meta name="keywords" content="@ViewData["keywords"]"/>
    <meta name="description" content="@ViewData["metaDescription"]"/>

    <link href="https://fonts.googleapis.com/css?family=Material+Icons" rel="stylesheet" type="text/css">
    <link href="https://cdn.jsdelivr.net/npm/quasar@2/dist/quasar.rtl.prod.css" rel="stylesheet" type="text/css">

</head>

<body>

<!-- Vue App -->
    <div id="q-app">
        <component :is="currentPage">@RenderBody()</component>
    </div>

<script src="https://cdn.jsdelivr.net/npm/vue@3/dist/vue.global.prod.js"></script>
<script src="https://cdn.jsdelivr.net/npm/quasar@2.18.0/dist/quasar.umd.prod.js"></script>
<script src="https://cdn.jsdelivr.net/npm/quasar@2/dist/lang/fa.umd.prod.js"></script>

<script>
    window.currentPageComponent = window.currentPageComponent || "default-page";

    const app = Vue.createApp({
        data() {
            return {
                currentPage: window.currentPageComponent
            };
        }
    });

    app.mount("#q-app");
    app.use(Quasar);
    Quasar.Lang.set(Quasar.Lang.fa);
</script>

@RenderSection("Scripts", required: false)

</body>
</html>