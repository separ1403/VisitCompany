@page
@model VisitCompany.Pages.Company.AddPeopleCompanyModel
@{
    Layout = "Shared/_AdminLayout";
    ViewData["title"] = "افزودن افراد شاغل در کسب و کارها";
}




<form method="post" asp-page-handler="Create" enctype="multipart/form-data">
    <div class="modal-body">
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="@Model.Command.NamePeopleCo" class="control-label">نام و نام خانوادگی فرد</label>
                    <input type="text" class="form-control" asp-for="@Model.Command.NamePeopleCo">
                    <span asp-validation-for="Command.NamePeopleCo " class="error"></span>


                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="@Model.Command.RspponsePeopleCo " class="control-label"> مسئولیت ایشان </label>
                    <input type="text" class="form-control" asp-for="Command.RspponsePeopleCo ">
                    <span asp-validation-for="Command.RspponsePeopleCo " class="error"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="@Model.Command.PhonePeopleCo" class="control-label"> شماره تماس ایشان </label>
                <input type="text" class="form-control" asp-for="@Model.Command.PhonePeopleCo">
                <span asp-validation-for="Command.PhonePeopleCo " class="error"></span>


            </div>

            <div class="form-group">
                <label class="sr-only" asp-for="@Model.Command.CompanyId"></label>
                <select class="form-control" asp-for="@Model.Command.CompanyId" asp-items="@Model.Companies"
                        id="CompanyIdSelect">

                    <option value="0"> شرکت مورد نظر را انتخاب نمایید</option>

                </select>
            </div>
            
            <div class="modal-footer">
                <button type="submit" class="btn btn-info waves-effect waves-light">ایجاد</button>
            </div>
        </div>
    </div>
</form>


@section Scripts {
    <script src="~/adminTheme/assets/datatables/jquery.dataTables.min.js"></script>
    <script src="~/adminTheme/assets/datatables/dataTables.bootstrap.js"></script>

    <script type="text/javascript">
        $(document).ready(function () {
            $('#CompanyIdSelect').select2({
                placeholder: "انتخاب دسته بندی",
                allowClear: true,
                language: "fa"
            });
        });
    </script>
}

