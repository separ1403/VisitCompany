@page
@model VisitCompany.Pages.Company.PeopleCompanyModel

@{
    Layout = "Shared/_AdminLayout";
    ViewData["title"] = "مدیریت چک لیست ها";

}


@if (@TempData["SuccessMessageameEd"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessageameEd"]

    </div>
}

@if (@TempData["ErrorMessageameEd"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessageameEd"]

    </div>
}


            

                <form class="form-inline" role="form" method="get">
                <div class="form-group">
                    <label class="sr-only" asp-for="@Model.SearchModel.NamePeopleCo"></label>
                    <input class="form-control" asp-for="@Model.SearchModel.NamePeopleCo" placeholder="  نام ">
                </div>
                    <div class="form-group">
                        <label class="sr-only" asp-for="@Model.SearchModel.RspponsePeopleCo"></label>
                        <input class="form-control" asp-for="@Model.SearchModel.RspponsePeopleCo" placeholder="  مسئولیت">
                    </div>
                 

                    <div class="form-group">
                        <label class="sr-only" asp-for="@Model.SearchModel.CompanyId"></label>
                        <select class="form-control" asp-for="@Model.SearchModel.CompanyId" asp-items="@Model.Companies" id="CompanyIdSelect">

                            <option value="0">  شرکت مورد نظر را انتخاب نمایید</option>

                        </select>
                    </div>

                <button type="submit" class="btn btn-success waves-effect waves-light m-l-10">جستجو</button>
                <a class="btn btn-primary waves-effect waves-light m-l-10" asp-page="./Index">مشاهده همه</a>
            </form>
        
  

<div class="panel-body">
    <div class="row">
        <div class="col-md-12 col-sm-12 col-xs-12">
            <table id="datatable" class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>تاریخ ارزیابی</th>
                        <th>نام افراد حاضر در کسب و کار</th>
                        <th>مسئولیت</th>
                        <th>شماره تماس</th>
                        <th>نام تجاری شرکت</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Persons)
                    {
                        <tr>
                            <td>@item.CreattionDate</td>
                            <td>@item.NamePeopleCo</td>
                            <td>@item.RspponsePeopleCo</td>
                            <td>@item.PhonePeopleCo</td>
                            <td>
                                @{
                                    var companyBrand = !string.IsNullOrEmpty(item.CompanyBrand) ? item.CompanyBrand : item.CompanyBrandChecklist;
                                    var suffix = !string.IsNullOrEmpty(item.CompanyBrandChecklist) ? " (حاضر در کسب و کار)" : "";
                                }
                                @companyBrand@Html.Raw(suffix)
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
