@page
@model VisitCompany.Pages.EnterCodeModel
@{
    ViewData["Title"] = "ورود و ثبت نام";
    Layout = "Shared/_Layout";
}

<!-- مشخص کردن کامپوننت صفحه -->
<script>
    window.currentPageComponent = "enter-code-page";
</script>

<!-- محتوای صفحه -->
<div>
    @Html.AntiForgeryToken()
    <enter-code-page></enter-code-page>
</div>

@section Styles {
    <link href="~/Theme/assets/css/pages/account.css" rel="stylesheet">
}

@section Scripts {
    <script>
        window.registerComponent('enter-code-page', {
            setup() {
                const code = Vue.ref('');
                const codeRef = Vue.ref(null);
                const codeRules = Vue.ref([
                    val => !!val || 'کد تأیید ضروری است',
                    val => /^\d{5}$/.test(val) || 'کد باید 5 رقم باشد' 
                ]);

                const $q = Quasar.useQuasar();

                const submitForm = async (event) => {
                    event.preventDefault();
                    console.log('Form submit prevented');

                    try {
                        const formData = new FormData();
                        formData.append('Code', code.value);
                        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                        if (!token) {
                            throw new Error('توکن ضد جعل پیدا نشد');
                        }
                        formData.append('__RequestVerificationToken', token);

                        const response = await fetch('/EnterCode?handler=ValidateCode', {
                            method: 'POST',
                            body: formData,
                            credentials: 'include'
                        });

                        let responseData;
                        if (response.headers.get('content-type')?.includes('application/json')) {
                            responseData = await response.json();
                        } else {
                            responseData = { message: await response.text() };
                        }

                        if (response.redirected) {
                            $q.notify({
                                type: 'positive',
                                message: 'کد تأیید شد، در حال انتقال...',
                                position: 'top'
                            });
                            window.location.href = response.url;
                        } else if (response.ok && response.status === 200) {
                            $q.notify({
                                type: 'positive',
                                message: responseData.message || 'کد تأیید شد',
                                position: 'top'
                            });
                        } else {
                            $q.notify({
                                type: 'negative',
                                message: responseData.message || 'کد تأیید اشتباه است',
                                position: 'top'
                            });
                        }
                    } catch (error) {
                        console.error('Fetch error:', error);
                        $q.notify({
                            type: 'negative',
                            message: 'خطا در تأیید کد: ' + error.message,
                            position: 'top'
                        });
                    }
                };

                return { code, codeRef, codeRules, submitForm };
            },
            template: `
<div class="account-bg">
<div class="auth-box">
<div class="auth-box__img">
<img src="/Theme/assets/img/etc/login-logo.png" alt="ورود به کاربری">
</div>
<div class="login">
                <q-form v-on:submit.prevent="submitForm" class="login-form full-width">
                    <q-input
                        ref="codeRef"
                        v-model="code"
                        name="Code"
                        autocomplete="one-time-code"
                        label="کد تأیید"
                        placeholder="کد تأیید"
                        outlined
                        class="q-mb-md full-width"
                        lazy-rules
                        :rules="codeRules"
                        mask="#####"
                    />
                    <div class="text-right">
                        <a href="/Account" class="forget-pass-link">ویرایش شماره موبایل</a>
                    </div>
                    <q-btn
                        type="submit"
                        label="ثبت کد تأیید"
                        size="lg"
                        color="deep-purple-9"
                        class="q-mt-md full-width"
                    />
                </q-form>
</div>
</div>
</div>            `
        });
    </script>
}