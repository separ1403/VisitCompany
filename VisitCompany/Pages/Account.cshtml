@page
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model AccountModel
@{
    ViewData["Title"] = "ورود و ثبت نام";
    Layout = "Shared/_Layout";
}

<!-- مشخص کردن کامپوننت صفحه -->
<script>
    window.currentPageComponent = "account-page";
</script>

<!-- محتوای صفحه -->
<div>
    @Html.AntiForgeryToken()
    <account-page></account-page>
</div>

@section Styles {
    <link href="~/Theme/assets/css/pages/account.css" rel="stylesheet">
}

@section Scripts {
    <script>
        window.registerComponent('account-page', {
            setup() {
                const username = Vue.ref('');
                const mobile = Vue.ref('');
                const loginMessage = Vue.ref('');

                const submitForm = async () => {
                    try {
                        const formData = new FormData();
                        formData.append('username', username.value);
                        formData.append('mobile', mobile.value);
                        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                        const response = await fetch('/Account?handler=Login', {
                            method: 'POST',
                            body: formData,
                            headers: {
                                'RequestVerificationToken': token
                            },
                            credentials: 'include' // برای اطمینان از ارسال کوکی‌ها و سشن
                        });
                        if (response.redirected) {
                            window.location.href = response.url; 
                        } else if (response.ok) {
                            window.location.reload();
                        } else {
                            const errorText = await response.text();
                            loginMessage.value = errorText || 'خطا در ورود';
                        }
                    } catch (error) {
                        loginMessage.value = 'ورود ناموفق بود! خطا: ' + error.message;
                    }
                };

                return {username, mobile, loginMessage, submitForm};
            },
            template: `
<div class="account-bg">
<div class="auth-box">
<div class="auth-box__img">
<img src="/Theme/assets/img/etc/login-logo.png" alt="ورود به کاربری">
</div>
<div class="login">
                <q-form v-on:submit.prevent="submitForm" class="login-form">
                    <q-input
                        v-model="username"
                        label="نام کاربری *"
                        placeholder="نام کاربری"
                        outlined
                        class="q-mb-md"
                        reverse-fill-mask
                    />
                    <q-input
                        v-model="mobile"
                        label="شماره تماس"
                        placeholder="شماره موبایل"
                        outlined
                        reverse-fill-mask
                    />
                    <div class="text-right">
                        <a href="#" class="forget-pass-link">فراموشی رمز</a>
                    </div>
                    <q-btn
                        type="submit"
                        label="دریافت کد"
size="lg"
                        color="deep-purple-9"
                        class="q-mt-md full-width"
                    />
                    <q-banner v-if="loginMessage" class="text-red q-mt-md">
                        {{ loginMessage }}
                    </q-banner>
                </q-form>
</div>
</div>
</div>            `
        });
    </script>
}