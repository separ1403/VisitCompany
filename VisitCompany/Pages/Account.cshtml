@page
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model AccountModel
@{
    ViewData["Title"] = "ورود و ثبت نام";
    Layout = "Shared/_Layout";
}
<script>
    window.currentPageComponent = "account-page";
</script>
@section Scripts {


    <script>
        const accountApp = Vue.createApp({
            setup() {
                const username = Vue.ref("");
                const mobile = Vue.ref("");
                const loginMessage = Vue.ref("");

                const validateForm = () => {
                    if (!username.value || !mobile.value) {
                        loginMessage.value = "لطفاً همه فیلدها را پر کنید.";
                        return false;
                    }
                    return true;
                };

                const submitForm = () => {
                    if (validateForm()) {
                        alert("ورود با موفقیت انجام شد!");
                    }
                };

                return { username, mobile, loginMessage, submitForm };
            },
            template: `
                <q-btn label="Hello" color="red"></q-btn>
            `
        });
        accountApp.component("account-page", accountApp);
        accountApp.mount("#q-app");
    </script>
}
