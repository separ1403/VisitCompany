@page
@model VisitCompany.Pages.ReportModel

@{
    Layout = "Shared/_AdminLayout";
    ViewData["Title"] = "گزارش";
    var data = new {
        CompaniesSearch = Model.CompaniesSearch,
        ChecklistsSearch = Model.ChecklistsSearch,
        LicencesSearch = Model.LicencesSearch, 
        PersonSearch = Model.PersonSearch,     
        Keyword = Model.Keyword,
        SearchCompanies = Model.SearchCompanies,
        SearchChecklists = Model.SearchChecklists,
        SearchLicences = Model.SearchLicences,
        SearchPersons = Model.SearchPersons
    };

    var reportJson = Newtonsoft.Json.JsonConvert.SerializeObject(data);
    Console.WriteLine("Server data: " + reportJson); 
}

<div>
    @Html.AntiForgeryToken()
    <report-page :init-data='@Html.Raw(reportJson)' />
</div>

@section Scripts {
    <script>
        registerComponent('report-page', {
            props: ['initData'],
            template: `
        <div>
          <div class="card-box q-my-md">
            <h2 class="card-box__title">جستجو</h2>
            <div class="card-box__body">
              <q-form v-on:submit.prevent="submitSearch">
                <div class="row q-col-gutter-md">
                  <div class="col-md-4 col-12">
                    <q-input v-model="filters.keyword" label="عبارت جستجو" filled />
                  </div>
                  <div class="col-md-8 col-12 q-mt-md q-mt-md-none">
                    <q-option-group
                      v-model="filters.targets"
                      :options="searchOptions"
                      type="checkbox"
                      inline
                    />
                  </div>
                </div>
                <div class="q-mt-md">
                  <q-btn type="submit" label="جستجو" color="primary" />
                </div>
              </q-form>
            </div>
          </div>

          <q-card v-if="initData.CompaniesSearch?.length" class="q-my-md" flat bordered>
            <q-card-section>
              <div class="text-h6">نتیجه جستجو در شرکت‌ها</div>
              <q-table
                :rows="initData.CompaniesSearch"
                :columns="companiesColumns"
                row-key="Id"
                flat
                bordered
                hide-pagination
              />
            </q-card-section>
          </q-card>

          <q-card v-if="initData.ChecklistsSearch?.length" class="q-my-md" flat bordered>
            <q-card-section>
              <div class="text-h6">نتیجه جستجو در ارزیابی‌ها</div>
              <q-table
                :rows="initData.ChecklistsSearch"
                :columns="checklistsColumns"
                row-key="companyName"
                flat
                bordered
                hide-pagination
              >
                <template v-slot:body-cell-scores="props">
                  <q-td :props="props">
                    <div v-if="props.row.averageGeneral > 0">ارزیابی عمومی: {{ props.row.averageGeneral }}</div>
                    <div v-if="props.row.averageGeneralProff > 0">فنی- عمومی: {{ props.row.averageGeneralProff }}</div>
                    <div v-if="props.row.averageGeneralPol > 0">انتظامی- عمومی: {{ props.row.averageGeneralPol }}</div>
                    <div v-if="props.row.averageJunipper > 0">جونیپر: {{ props.row.averageJunipper }}</div>
                    <div v-if="props.row.averageWin2019 > 0">Win2019: {{ props.row.averageWin2019 }}</div>
                    <div v-if="props.row.averageHpedl380 > 0">HPEDL380: {{ props.row.averageHpedl380 }}</div>
                  </q-td>
                </template>
              </q-table>
            </q-card-section>
          </q-card>

          <q-card v-if="initData.LicencesSearch?.length" class="q-my-md" flat bordered>
            <q-card-section>
              <div class="text-h6">نتیجه جستجو در مجوزها</div>
              <q-table
                :rows="initData.LicencesSearch"
                :columns="licencesColumns"
                row-key="Id"
                flat
                bordered
                hide-pagination
              />
            </q-card-section>
          </q-card>

          <q-card v-if="initData.PersonSearch?.length" class="q-my-md" flat bordered>
            <q-card-section>
              <div class="text-h6">نتیجه جستجو در افراد</div>
              <q-table
                :rows="initData.PersonSearch"
                :columns="personsColumns"
                row-key="Id"
                flat
                bordered
                hide-pagination
              />
            </q-card-section>
          </q-card>
        </div>
      `,
            setup(props) {
                const { ref } = Vue;

                console.log('initData:', props.initData);
                console.log('CompaniesSearch:', props.initData.CompaniesSearch);
                console.log('ChecklistsSearch:', props.initData.ChecklistsSearch);
                console.log('LicencesSearch:', props.initData.LicencesSearch);
                console.log('PersonSearch:', props.initData.PersonSearch);

                const filters = ref({
                    keyword: props.initData.keyword || '',
                    targets: [
                        props.initData.searchCompanies && 'SearchCompanies',
                        props.initData.searchChecklists && 'SearchChecklists',
                        props.initData.searchLicences && 'SearchLicences',
                        props.initData.searchPersons && 'SearchPersons'
                    ].filter(Boolean)
                });

                const searchOptions = [
                    { label: 'شرکت‌ها', value: 'SearchCompanies' },
                    { label: 'چک‌لیست‌ها', value: 'SearchChecklists' },
                    { label: 'مجوزها', value: 'SearchLicences' },
                    { label: 'افراد', value: 'SearchPersons' }
                ];

                const companiesColumns = [
                    { name: 'Id', label: 'شناسه', field: 'Id', align: 'center' },
                    { name: 'CompanyName', label: 'نام شرکت', field: 'CompanyName', align: 'center' },
                    { name: 'Brand', label: 'برند', field: 'Brand', align: 'center' },
                    { name: 'ManagerName', label: 'نام مدیر', field: 'ManagerName', align: 'center' }
                ];

                const checklistsColumns = [
                    { name: 'Id', label: 'شناسه', field: 'Id', align: 'center' },
                    { name: 'Title', label: 'عنوان', field: 'Title', align: 'center' },
                    { name: 'scores', label: 'نمرات انطباق پذیری', field: 'scores', align: 'center' }
                ];

                const personsColumns = [
                    { name: 'CompanyBrand', label: 'نام شرکت', field: 'CompanyBrand', align: 'center' },
                    { name: 'NamePeopleCo', label: 'نام فرد', field: 'NamePeopleCo', align: 'center' },
                    { name: 'RspponsePeopleCo', label: 'مسئولیت فرد‌', field: 'RspponsePeopleCo', align: 'center' },
                    { name: 'PhonePeopleCo', label: 'موبایل فرد‌', field: 'PhonePeopleCo', align: 'center' }
                ];

                const licencesColumns = [
                    { name: 'Name', label: 'نام', field: 'Name', align: 'center' },
                    { name: 'Description', label: 'توضیحات', field: 'Description', align: 'center' },
                    { name: 'Status', label: 'وضعیت', field: 'Status', align: 'center' }
                ];

                function submitSearch() {
                    console.log('Submitting with filters:', filters.value);
                    const form = document.createElement('form');
                    form.method = 'POST';
                    form.action = '/Report';

                    const keywordInput = document.createElement('input');
                    keywordInput.type = 'hidden';
                    keywordInput.name = 'Keyword';
                    keywordInput.value = filters.value.keyword;
                    form.appendChild(keywordInput);

                    filters.value.targets.forEach(target => {
                        const input = document.createElement('input');
                        input.type = 'hidden';
                        input.name = target;
                        input.value = 'true';
                        form.appendChild(input);
                    });

                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                    if (token) {
                        const tokenInput = document.createElement('input');
                        tokenInput.type = 'hidden';
                        tokenInput.name = '__RequestVerificationToken';
                        tokenInput.value = token;
                        form.appendChild(tokenInput);
                    } else {
                        console.error('توکن ضد جعل پیدا نشد!');
                        return;
                    }

                    document.body.appendChild(form);
                    form.submit();
                }

                return {
                    filters,
                    searchOptions,
                    companiesColumns,
                    checklistsColumns,
                    licencesColumns,
                    personsColumns,
                    submitSearch
                };
            }
        });
    </script>
}